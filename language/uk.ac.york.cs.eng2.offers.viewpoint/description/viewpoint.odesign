            </initialOperation>
          </ownedTools>
          <ownedTools xsi:type="tool:ContainerCreationDescription" name="offers.products.tools.createProduct" label="Create Product" containerMappings="//@ownedViewpoints[name='Viewpoint']/@ownedRepresentations[name='offers.diagrams.products']/@additionalLayers[name='offers.products.layers.products']/@containerMappings[name='offers.products.containers.products']">
