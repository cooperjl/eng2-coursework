          <ownedTools xsi:type="tool:NodeCreationDescription" name="offers.products.tools.createTag" label="Create Tag" nodeMappings="//@ownedViewpoints[name='Viewpoint']/@ownedRepresentations[name='offers.diagrams.products']/@additionalLayers[name='offers.products.layers.products']/@containerMappings[name='offers.products.containers.products']/@subNodeMappings[name='offers.products.nodes.tags']">
            <variable name="container"/>
