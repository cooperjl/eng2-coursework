                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="offers::Tag" referenceName="tags">
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:container">
                    <subModelOperations xsi:type="tool_1:SetValue" featureName="tags" valueExpression="var:instance"/>
                  </subModelOperations>
                </subModelOperations>
