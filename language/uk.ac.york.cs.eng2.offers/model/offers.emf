@namespace(uri="http://cs.york.ac.uk/eng2/202425/offers", prefix="dis")
package offers;

class Model {
	val Product[*] products;
	val Category[*] categories;
	val Tag[*] tags;
	val Offer[*] offers;
}

class Category {
	attr String name;
	val Category[*] subcategories;
	ref Product[*] products;
}

class Product {
	attr String name;
	ref Tag[*] tags;
}

class Tag {
	attr String name;
}

class Offer {
	attr String name;
	val Condition[*] conditions;
	val Action[+] actions;
	val Trigger[0..2] triggers;
}

enum TriggerOn {
	ALWAYS;
	IF_MATCH;
	IF_NOT_MATCH;
}

class Trigger {
	attr TriggerOn triggerOn;
	ref Offer offer;
}

enum Comparison {
	EQUAL;
	NOT_EQUAL;
	LESS_THAN;
	LESS_THAN_EQUAL;
	GREATER_THAN;
	GREATER_THAN_EQUAL;
}

abstract class Condition {
	attr String name;
}

class TaggedCondition extends Condition {
	ref Tag[+] tags;
}

class ProductCondition extends Condition {
	ref Product product;
}

class DailyOrderCondition extends Condition {
	ref Product product;
	attr Comparison comparison;
	attr int threshold;
}

class PriceCondition extends Condition {
	attr float price;
	attr Comparison comparison;
}

class DateRangeCondition extends Condition {
	attr Date startDate;
	attr Date endDate;
}

abstract class Action {
	attr String name;
	attr float percentageDiscount;
	attr float priceDiscount;
	attr float setPrice;
}

class TaggedDiscount extends Action {
	attr int quantityDiscount;
	ref Tag[+] tags;
}

class ProductDiscount extends Action {
	attr int quantityDiscount;
	ref Product product;
}

class OrderDiscount extends Action {
}
